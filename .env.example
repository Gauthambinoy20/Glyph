# ── Glyph configuration ── copy this file to `.env` and fill in. Never commit `.env`.

# --- LLM (chat) via OpenRouter free tier ---
# Get a FREE key at https://openrouter.ai (GitHub login, no card needed).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=                              # your free OpenRouter key (sk-or-v1-...)
LLM_MODEL=openai/gpt-oss-120b:free        # default model (free, large open model)
LLM_FALLBACK_MODEL=openai/gpt-oss-20b:free  # used if the default is busy/unavailable

# Optional: enables the "cheapest paid" models in the dropdown. Leave blank to stay 100% free.
OPENAI_API_KEY=

# --- Embeddings: LOCAL by default (free, no key, offline) ---
EMBED_BACKEND=local                       # local | openai | static
EMBED_MODEL=BAAI/bge-small-en-v1.5
MODEL_CACHE_DIR=.model_cache              # where the local embedding model is cached

# Fast mode: EMBED_BACKEND=static uses Model2Vec static embeddings — ~100x faster ingest on
# CPU, no neural inference. Some accuracy is traded but the reranker + BM25 largely recover it.
# STATIC_MODEL=minishlab/potion-base-8M   # 256-dim; only used when EMBED_BACKEND=static

# Two-stage retrieval: a cross-encoder reranks the recall pool for sharper answers. ON by
# default (lifts top-1 hit-rate 80%->90% on the golden set); falls back to single-stage if the
# model can't load. Set RERANKER_ENABLED=false to skip it.
# RERANKER_ENABLED=false
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATES=20

# --- Storage paths ---
CHROMA_DIR=chroma_db                      # vector DB on disk
DB_PATH=glyph.sqlite                      # chat history

# --- Ingest limits (safety) ---
MAX_FILE_BYTES=1000000                    # skip files larger than this (1 MB)
MAX_FILES=2000                            # cap files per repo
MAX_CHUNK_LINES=120                       # sub-split functions larger than this

# --- App ---
APP_URL=http://localhost:5173             # used for OpenRouter attribution header (optional)
